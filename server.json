{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "flights.lowest/agent-flights",
  "description": "Cheapest flights worldwide, strong on Africa, with attributed booking links.",
  "title": "Agent Flights",
  "repository": {
    "url": "https://github.com/lomiafrica/agent-flights-mcp",
    "source": "github"
  },
  "version": "1.2.2",
  "websiteUrl": "https://lowest.flights/agents",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://lowest.flights/mcp",
      "headers": [
        {
          "description": "Optional. Bearer token for an Agent Flights MCP key. Not needed while MCP is free.",
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://lowest.flights/mcp-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://lowest.flights/mcp-icon-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ]
}
